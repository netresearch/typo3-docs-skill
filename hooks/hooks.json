{
  "description": "TYPO3 docs hooks for RST syntax validation before writes",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PLUGIN_ROOT}/scripts/validate_rst.py\" || true",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PLUGIN_ROOT}/scripts/validate_rst.py\" || true",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
